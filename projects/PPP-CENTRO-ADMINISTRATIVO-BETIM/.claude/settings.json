{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(/registros/**)",
      "Read(/governanca/**)",
      "Edit(/produtos/**)"
    ],
    "deny": [
      "Edit(/dados/**)",
      "Edit(/registros/**)",
      "Edit(/governanca/**)",
      "Edit(/.claude/**)",
      "Edit(/scripts/**)",
      "Edit(/testes/**)",
      "Edit(/arquitetura/**)",
      "Edit(/referencias/**)",
      "Edit(/logs/**)",
      "Edit(/projects/**)",
      "Edit(/*.md)",
      "Edit(/*.txt)",
      "Edit(/*.lock)",
      "Edit(/.gitignore)",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_ferramentas.py\" || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
